/** @file remove electron weight captured by recombination processes from the free electron macro particles
 *
 * Statistical mean field capture model: each macro electron of a histogram bin is reweighted by the bin's captured
 *  weight fraction, instead of removing individual macro electrons. This conserves charge and electron number in
 *  aggregate per bin, but is not a resolved three-particle collision.
 */

#pragma once

#include "picongpu/defines.hpp"
#include "picongpu/particles/atomicPhysics/GetPhysicalEnergy.hpp"
#include "picongpu/particles/atomicPhysics/debug/ElectronCapture.hpp"

#include <pmacc/lockstep.hpp>
#include <pmacc/particles/algorithm/ForEach.hpp>

#include <cstdint>

namespace picongpu::particles::atomicPhysics::kernel
{
    /** apply electron capture kernel
     *
     * @attention assumes that the captured weight cache has been filled by the RecordChanges sub-stage previously
     * @attention must run before the DecelerateElectrons sub-stage: electron energies are then still unchanged
     *  since the histogram binning, so each electron's bin lookup matches the bin the captured weight was selected
     *  and reserved from
     *
     * called by ApplyElectronCapture sub-stage, reduces the weighting of all macro electrons of the species
     *  T_Electron in the given superCell by their bin's captured weight fraction and marks macro electrons falling
     *  below MIN_WEIGHTING for deletion. The macro particle momentum is weight-scaled and therefore reduced by the
     *  same fraction, keeping the per physical electron energy unchanged.
     */
    template<typename T_Electron, typename T_Histogram>
    struct ApplyElectronCaptureKernel
    {
        /** call operator
         *
         * called by ApplyElectronCapture atomic physics sub-stage
         *
         * @param worker object containing the device and block
         *  information, passed by PMACC_KERNEL call
         * @param areMapping mapping of blockIndex to block superCell index
         * @param timeRemainingBox deviceDataBox giving access to the local time remaining of all local super
         * cells
         * @param electronBox deviceDataBox giving access to the electron species particle frames
         *   of all local superCells
         * @param electronHistogramDataBox deviceDataBox giving access to the
         *  local electron histograms of all local superCells
         * @param capturedWeightCacheBox deviceDataBox giving access to the captured weight cache of all local
         *  superCells
         */
        template<
            typename T_Worker,
            typename T_AreaMapping,
            typename T_LocalTimeRemainingBox,
            typename T_ElectronBox,
            typename T_LocalElectronHistogramDataBox,
            typename T_LocalCapturedWeightCacheBox>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_AreaMapping const areaMapping,
            T_LocalTimeRemainingBox const timeRemainingBox,
            T_ElectronBox electronBox,
            T_LocalElectronHistogramDataBox electronHistogramDataBox,
            T_LocalCapturedWeightCacheBox capturedWeightCacheBox) const
        {
            pmacc::DataSpace<simDim> const superCellIdx = areaMapping.getSuperCellIndex(worker.blockDomIdxND());

            // atomicPhysics superCellFields have no guard, but areMapping includes a guard
            //  -> must subtract guard to get correct superCellFieldIdx
            pmacc::DataSpace<picongpu::simDim> const superCellFieldIdx
                = superCellIdx - areaMapping.getGuardingSuperCells();

            auto const timeRemaining = timeRemainingBox(superCellFieldIdx);

            auto forEachLocalElectronBoxEntry
                = pmacc::particles::algorithm::acc::makeForEach(worker, electronBox, superCellIdx);

            // end kernel if superCell already finished or if contains no particles
            if((timeRemaining <= 0._X) || (!forEachLocalElectronBoxEntry.hasParticles()))
                return;

            T_Histogram& histogram = electronHistogramDataBox(superCellFieldIdx);
            auto& capturedWeightCache = capturedWeightCacheBox(superCellFieldIdx);

            namespace debugCapture = picongpu::atomicPhysics::debug::electronCapture;

            forEachLocalElectronBoxEntry(
                [&histogram, &capturedWeightCache](T_Worker const& worker, auto& electron)
                {
                    // eV
                    float_X const energyElectron = GetPhysicalEnergy::KineticEnergy(electron);

                    // no corresponding bin exists
                    if(!histogram.inRange(energyElectron))
                        return;

                    uint32_t const binIndex = histogram.getBinIndex(energyElectron);

                    // unitless
                    float_X const capturedWeightBin = capturedWeightCache.getCapturedWeight(binIndex);
                    if(capturedWeightBin <= 0._X)
                        return;

                    // unitless
                    float_X const weightBin = histogram.getBinWeight0(binIndex);
                    if(weightBin <= 0._X)
                        return;

                    /* over subscription handling is supposed to guarantee
                     *  capturedWeight <= deltaWeight <= weight0, clamp against float rounding */
                    float_X const rawFraction = capturedWeightBin / weightBin;
                    float_X const captureFraction = pmacc::math::min(rawFraction, 1._X);

                    if constexpr(debugCapture::CHECK_WEIGHT_BALANCE)
                        if(rawFraction > 1._X)
                        {
                            /* capturedWeight exceeds the weight the bin ever held: the excess is silently not
                             *  removed while the ions have already been recombined -> net electron creation */
                            capturedWeightCache.addClampedWeight(
                                worker,
                                binIndex,
                                (rawFraction - 1._X) * electron[weighting_]);
                        }

                    float_X const newWeighting = electron[weighting_] * (1._X - captureFraction);

                    if(newWeighting < picongpu::particles::MIN_WEIGHTING)
                    {
                        /* mark macro electron for deletion, host side stage must call fillAllGaps() afterwards,
                         *  residual weight below MIN_WEIGHTING is accepted leakage */
                        if constexpr(debugCapture::CHECK_WEIGHT_BALANCE)
                        {
                            // the whole macro particle disappears, so all of its weight is removed ...
                            capturedWeightCache.addRemovedWeight(worker, binIndex, electron[weighting_]);
                            // ... of which newWeighting was never meant to be captured
                            capturedWeightCache.addDeletionResidual(worker, binIndex, newWeighting);
                        }
                        electron[multiMask_] = 0;
                        return;
                    }

                    if constexpr(debugCapture::CHECK_WEIGHT_BALANCE)
                        capturedWeightCache.addRemovedWeight(worker, binIndex, electron[weighting_] * captureFraction);

                    electron[weighting_] = newWeighting;
                    // momentum is weight-scaled, rescale to keep the per physical electron energy unchanged
                    electron[momentum_] *= (1._X - captureFraction);
                });
        }
    };

#if PARAM_CHECK_ELECTRON_CAPTURE_BALANCE == 1
    //! Check all bins after capture has been applied to every electron species.
    struct CheckElectronCaptureBalanceKernel
    {
        template<typename T_Worker, typename T_Mapper, typename T_TimeBox, typename T_CacheBox>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_Mapper const mapper,
            T_TimeBox timeBox,
            T_CacheBox cacheBox,
            uint32_t const step,
            uint64_t const subStep,
            uint32_t const rank) const
        {
            auto const idx = mapper.getSuperCellIndex(worker.blockDomIdxND()) - mapper.getGuardingSuperCells();
            if(timeBox(idx) <= 0._X)
                return;
            auto onlyMaster = pmacc::lockstep::makeMaster(worker);
            onlyMaster(
                [&]()
                {
                    auto const& cache = cacheBox(idx);
                    using Cache = typename T_CacheBox::ValueType;

                    int z = 0;
                    if constexpr(simDim == 3)
                        z = static_cast<int>(idx[2]);

                    for(uint32_t bin = 0; bin < Cache::numberBins; ++bin)
                    {
                        float_X const captured = cache.getCapturedWeight(bin);
                        float_X const removed = cache.getRemovedWeight(bin);
                        float_X const clamped = cache.getClampedWeight(bin);
                        float_X const residual = cache.getDeletionResidual(bin);
                        uint32_t const rejected = cache.getRejectedReservations(bin);
                        float_X const scale = pmacc::math::max(captured, removed);
                        float_X const tolerance
                            = picongpu::atomicPhysics::debug::electronCapture::BALANCE_TOLERANCE * scale;

                        // Includes excess removal from MIN_WEIGHTING deletion.
                        float_X const chargeDifference = removed - captured;
                        float_X const unexplainedDifference = chargeDifference - residual;

                        // Negated comparisons report NaNs as well as ordinary mismatches.
                        bool const imbalance = !(
                            unexplainedDifference <= tolerance && unexplainedDifference >= -tolerance
                            && clamped <= tolerance && captured >= 0._X && removed >= 0._X);
                        if(imbalance)
                        {
                            printf(
                                "[electronCapture balance] step %u subStep %llu rank %u "
                                "superCell (%d,%d,%d) bin %u: captured %.9e removed %.9e "
                                "chargeDifference %+.9e minWeightResidual %.9e unexplainedDifference %+.9e "
                                "clamped %.9e\n",
                                step,
                                static_cast<unsigned long long>(subStep),
                                rank,
                                static_cast<int>(idx[0]),
                                static_cast<int>(idx[1]),
                                z,
                                bin,
                                static_cast<double>(captured),
                                static_cast<double>(removed),
                                static_cast<double>(chargeDifference),
                                static_cast<double>(residual),
                                static_cast<double>(unexplainedDifference),
                                static_cast<double>(clamped));
                        }

                        /* MIN_WEIGHTING deletion loss is intentional, accepted leakage(see ApplyElectronCapture
                         *  kernel), so it does not by itself count as an imbalance above. Report it separately
                         *  when it is not small, so a significant deletion loss is never invisible merely because
                         *  it cancels out of unexplainedDifference. */
                        if(residual > tolerance)
                        {
                            printf(
                                "[electronCapture leakage] step %u subStep %llu rank %u "
                                "superCell (%d,%d,%d) bin %u: minWeightResidual %.9e (MIN_WEIGHTING deletion, "
                                "accepted)\n",
                                step,
                                static_cast<unsigned long long>(subStep),
                                rank,
                                static_cast<int>(idx[0]),
                                static_cast<int>(idx[1]),
                                z,
                                bin,
                                static_cast<double>(residual));
                        }

                        // Report reservation rejections separately from balance errors.
                        if(rejected != 0u)
                        {
                            printf(
                                "[electronCapture rejected] step %u subStep %llu rank %u "
                                "superCell (%d,%d,%d) bin %u: rejected %u reservation(s)\n",
                                step,
                                static_cast<unsigned long long>(subStep),
                                rank,
                                static_cast<int>(idx[0]),
                                static_cast<int>(idx[1]),
                                z,
                                bin,
                                rejected);
                        }
                    }

                    uint32_t const invalidBinIndexCalls = cache.getInvalidBinIndexCalls();
                    if(invalidBinIndexCalls != 0u)
                    {
                        printf(
                            "[electronCapture invalidIndex] step %u subStep %llu rank %u "
                            "superCell (%d,%d,%d): %u call(s) with an out-of-range bin index\n",
                            step,
                            static_cast<unsigned long long>(subStep),
                            rank,
                            static_cast<int>(idx[0]),
                            static_cast<int>(idx[1]),
                            z,
                            invalidBinIndexCalls);
                    }
                });
        }
    };
#endif
} // namespace picongpu::particles::atomicPhysics::kernel

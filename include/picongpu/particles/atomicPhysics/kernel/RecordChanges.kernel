#pragma once

#include "picongpu/defines.hpp"
#include "picongpu/particles/atomicPhysics/CheckSetOfAtomicDataBoxes.hpp"
#include "picongpu/particles/atomicPhysics/ConvertEnum.hpp"
#include "picongpu/particles/atomicPhysics/DeltaEnergyTransition.hpp"
#include "picongpu/particles/atomicPhysics/KernelIndexation.hpp"
#include "picongpu/particles/atomicPhysics/SetAtomicState.hpp"
#include "picongpu/particles/atomicPhysics/enums/IsProcess.hpp"
#include "picongpu/particles/atomicPhysics/enums/ProcessClass.hpp"
#include "picongpu/particles/atomicPhysics/enums/ProcessClassGroup.hpp"
#include "picongpu/particles/atomicPhysics/ionizationPotentialDepression/GetIPD.hpp"
#include "picongpu/particles/atomicPhysics/ionizationPotentialDepression/PassIPDInputs.hpp"

#include <pmacc/memory/shared/Allocate.hpp>
#include <pmacc/particles/algorithm/ForEach.hpp>
#include <pmacc/static_assert.hpp>

#include <cstdint>

namespace picongpu::particles::atomicPhysics::kernel
{
    namespace s_enums = picongpu::particles::atomicPhysics::enums;

    /** update atomic state and for collisional processes add delta energy of transition
     *  to used electron histogram bin
     *
     * @tparam T_ProcessClass processClass for which to execute this kernel
     * @tparam T_IPDModel ionization potential depression model to use for energy calculation
     */
    template<s_enums::ProcessClass T_ProcessClass, typename T_IPDModel>
    struct RecordChangesKernel
    {
        using VectorIdx = pmacc::DataSpace<picongpu::simDim>;

        /** call operator
         *
         * called by RecordChanges atomicPhysics sub-stage for each active processClass
         *
         * @param worker object containing the device and block information, passed by PMACC_KERNEL call
         * @param areaMapping mapping of blockIndex to block superCell index
         * @param timeRemainingBox deviceDataBox giving access to the local time remaining of all local super
         * cells
         * @param ionBox deviceDataBox giving access to the particle frames of all local superCells
         * @param electronHistogramDataBox deviceDataBox giving access to the local
         *  electron histograms of all local superCells
         * @param atomicStateBox deviceDataBox giving access to atomic state property data
         * @param transitionBox deviceDataBox giving access to transition property data,
         * @param chargeStateBoxAndIPDInput optional deviceDataBoxes giving access to charge state property data
         *  and the IPD input data, required for T_ProcessClassGroup = boundFreeBased
         */
        template<
            typename T_Worker,
            typename T_AreaMapping,
            typename T_LocalTimeRemainingBox,
            typename T_IonBox,
            typename T_LocalElectronHistogramDataBox,
            typename T_AtomicStateDataBox,
            typename T_TransitionDataBox,
            typename T_AtomicEnergyExchangeBox,
            typename... T_ChargeStateBoxAndIPDInput>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_AreaMapping const areaMapping,
            T_LocalTimeRemainingBox const timeRemainingBox,
            T_IonBox ionBox,
            T_LocalElectronHistogramDataBox electronHistogramDataBox,
            T_AtomicStateDataBox const atomicStateBox,
            T_TransitionDataBox const transitionBox,
            T_AtomicEnergyExchangeBox atomicEnergyExchangeBox,
            T_ChargeStateBoxAndIPDInput... chargeStateBoxAndIPDInput) const
        {
            PMACC_CASSERT(
                CheckSetOfAtomicDataBoxes::
                    transitionDataBoxMatchesProcessClass<T_ProcessClass, T_TransitionDataBox>());

            constexpr bool isCollisional
                = s_enums::IsProcess<s_enums::ProcessClassGroup::electronicCollisional>::check(u8(T_ProcessClass));
            constexpr bool isIonizing
                = s_enums::IsProcess<s_enums::ProcessClassGroup::ionizing>::check(u8(T_ProcessClass));
            constexpr bool isUpward
                = s_enums::IsProcess<s_enums::ProcessClassGroup::upward>::check(u8(T_ProcessClass));

            VectorIdx const superCellIdx = KernelIndexation::getSuperCellIndex(worker, areaMapping);
            VectorIdx const superCellFieldIdx
                = KernelIndexation::getSuperCellFieldIndexFromSuperCellIndex(areaMapping, superCellIdx);

            auto const timeRemaining = timeRemainingBox(superCellFieldIdx);
            auto forEachLocalIonBoxEntry = pmacc::particles::algorithm::acc::makeForEach(worker, ionBox, superCellIdx);

            bool const superCellAlreadyFinished = (timeRemaining <= 0._X);
            bool const superCellHasIons = forEachLocalIonBoxEntry.hasParticles();
            if(superCellAlreadyFinished || !superCellHasIons)
                return;

            using Histogram = typename T_LocalElectronHistogramDataBox::ValueType;

            // get histogram for current superCell
            [[maybe_unused]] Histogram& electronHistogram = electronHistogramDataBox(superCellFieldIdx);
            auto& atomicEnergyExchange = atomicEnergyExchangeBox(superCellFieldIdx);

            //! spontaneous deexcitation is the only process of this kernel emitting an escaping photon
            constexpr bool isRadiative = (u8(T_ProcessClass) == u8(s_enums::ProcessClass::spontaneousDeexcitation));

            // eV
            PMACC_SMEM(worker, superCellConstantIPDInput, typename T_IPDModel::SuperCellConstantInput);

            /* block wide accumulators of the atomic energy ledger, weighted eV
             *
             * accumulated per worker thread and reduced once per block, see AtomicEnergyExchange */
            PMACC_SMEM(worker, sharedAtomicEnergy, float_64);
            PMACC_SMEM(worker, sharedRadiatedEnergy, float_64);

            auto onlyMaster = lockstep::makeMaster(worker);
            onlyMaster(
                [&superCellConstantIPDInput,
                 &sharedAtomicEnergy,
                 &sharedRadiatedEnergy,
                 &superCellFieldIdx,
                 &chargeStateBoxAndIPDInput...]()
                {
                    sharedAtomicEnergy = 0.0;
                    sharedRadiatedEnergy = 0.0;

                    if constexpr(isIonizing)
                    {
                        superCellConstantIPDInput
                            = ionizationPotentialDepression::PassIPDInputs::template getSuperCellConstantInput<
                                T_IPDModel>(superCellFieldIdx, chargeStateBoxAndIPDInput...);
                    }
                });
            worker.sync();

            // weighted eV, private to this worker thread
            float_64 threadAtomicEnergy = 0.0;
            [[maybe_unused]] float_64 threadRadiatedEnergy = 0.0;

            forEachLocalIonBoxEntry(
                [&electronHistogram,
                 &threadAtomicEnergy,
                 &threadRadiatedEnergy,
                 &atomicStateBox,
                 &transitionBox,
                 &superCellConstantIPDInput,
                 &chargeStateBoxAndIPDInput...](T_Worker const& worker, auto& ion)
                {
                    if constexpr(picongpu::atomicPhysics::debug::kernel::recordChanges::CHECK_FOR_ACCEPTANCE)
                        if(!ion[accepted_])
                            printf("atomicPhysics ERROR: non accepted ion detected in recordChanges kernel\n");

                    uint8_t const processClass = ion[processClass_];

                    // not a T_ProcessClass transition
                    if((processClass) != u8(T_ProcessClass))
                        return;

                    uint32_t const transitionIndex = ion[transitionIndex_];

                    // positive energy difference between the upper and lower atomic states, eV
                    float_X transitionEnergy = 0._X;
                    if constexpr(isIonizing)
                    {
                        // eV
                        float_X const ionizationPotentialDepression
                            = ionizationPotentialDepression::template getIPD<T_IPDModel>(
                                atomicStateBox,
                                ion[atomicStateCollectionIndex_],
                                superCellConstantIPDInput);

                        transitionEnergy = picongpu::particles::atomicPhysics::DeltaEnergyTransition::get(
                            transitionIndex,
                            atomicStateBox,
                            transitionBox,
                            ionizationPotentialDepression,
                            chargeStateBoxAndIPDInput...);
                    }
                    else
                    {
                        transitionEnergy = picongpu::particles::atomicPhysics::DeltaEnergyTransition::get(
                            transitionIndex,
                            atomicStateBox,
                            transitionBox);
                    }

                    uint32_t newAtomicStateCollectionIndex;
                    if constexpr(isUpward)
                    {
                        // new state is upper state of transition
                        newAtomicStateCollectionIndex = transitionBox.upperStateCollectionIndex(transitionIndex);
                    }
                    else
                    {
                        // downward process, new state is lower state of transition
                        newAtomicStateCollectionIndex = transitionBox.lowerStateCollectionIndex(transitionIndex);
                    }

                    // update atomic state
                    picongpu::particles::atomicPhysics::SetAtomicState::op(
                        atomicStateBox,
                        ion,
                        newAtomicStateCollectionIndex);

                    /* no energy accounting if using fixed matrix
                     *
                     * @attention the atomic energy ledger below must stay on this side of the early return, so
                     *  that it only ever records exchanges whose counterpart (histogram, radiation) also
                     *  happened */
                    if constexpr(picongpu::atomicPhysics::debug::fixedRateMatrix::
                                     USE_FIXED_RATE_INSTEAD_OF_RATE_CALCULATION)
                        return;

                    float_64 const weightedTransitionEnergy
                        = static_cast<float_64>(transitionEnergy) * static_cast<float_64>(ion[weighting_]);
                    threadAtomicEnergy += isUpward ? weightedTransitionEnergy : -weightedTransitionEnergy;

                    if constexpr(isRadiative)
                        threadRadiatedEnergy += weightedTransitionEnergy;

                    /* record used energy
                     *
                     * @attention deltaEnergy is the energy of ONE physical ion, while the histogram's
                     *  binDeltaEnergy is a WEIGHTED quantity -- DecelerateElectrons divides it by the bin's
                     *  surviving weight to recover the per physical electron energy shift. The macro ion
                     *  stands for ion[weighting_] physical ions, so the energy must be scaled by the weight
                     *  before being handed to the histogram, exactly as the three-body recombination
                     *  specialization below and the field ionization branch of RecordSuggestedChanges do. */
                    if constexpr(isCollisional)
                    {
                        float_X const electronDeltaEnergy = isUpward ? -transitionEnergy : transitionEnergy;
                        electronHistogram.addDeltaEnergy(
                            worker,
                            ion[binIndex_],
                            electronDeltaEnergy * ion[weighting_]);
                    }
                });

            // reduce the ledger contributions of this block, one global atomic per block instead of per macro ion
            alpaka::atomicAdd(
                worker.getAcc(),
                &sharedAtomicEnergy,
                threadAtomicEnergy,
                ::alpaka::hierarchy::Threads{});
            if constexpr(isRadiative)
                alpaka::atomicAdd(
                    worker.getAcc(),
                    &sharedRadiatedEnergy,
                    threadRadiatedEnergy,
                    ::alpaka::hierarchy::Threads{});
            worker.sync();

            onlyMaster(
                [&worker, &atomicEnergyExchange, &sharedAtomicEnergy, &sharedRadiatedEnergy]()
                {
                    atomicEnergyExchange.template addAtomicEnergyBlockWide<T_ProcessClass>(
                        worker,
                        sharedAtomicEnergy);
                    if constexpr(isRadiative)
                        atomicEnergyExchange.template addRadiatedEnergyBlockWide<T_ProcessClass>(
                            worker,
                            sharedRadiatedEnergy);
                });
        }
    };

    /** specialization for three-body recombination
     *
     * Three-body recombination does not fit the generic kernel's trait branches: it is collisional and downward but
     *  requires the IPD-shifted ionization energy, and in addition to the atomic state update it must record the
     *  captured electron weight for the electron capture sub-stage.
     *
     * Energy accounting: the captured electron leaves the free electron population with its weight and kinetic
     *  energy, the released binding energy plus the captured electron's kinetic energy heat the remaining free
     *  electrons of the bin, giving a net free electron energy gain of deltaEnergy * weight per transition.
     */
    template<typename T_IPDModel>
    struct RecordChangesKernel<s_enums::ProcessClass::threeBodyRecombination, T_IPDModel>
    {
        using VectorIdx = pmacc::DataSpace<picongpu::simDim>;

        /** call operator
         *
         * called by RecordChanges atomicPhysics sub-stage
         *
         * @param worker object containing the device and block information, passed by PMACC_KERNEL call
         * @param areaMapping mapping of blockIndex to block superCell index
         * @param timeRemainingBox deviceDataBox giving access to the local time remaining of all local super
         * cells
         * @param ionBox deviceDataBox giving access to the particle frames of all local superCells
         * @param electronHistogramDataBox deviceDataBox giving access to the local
         *  electron histograms of all local superCells
         * @param atomicStateBox deviceDataBox giving access to atomic state property data
         * @param transitionBox deviceDataBox giving access to bound-free transition property data, sorted by upper
         *  state
         * @param capturedWeightCacheBox deviceDataBox giving access to the captured weight cache of all local
         *  superCells
         * @param chargeStateBoxAndIPDInput deviceDataBoxes giving access to charge state property data
         *  and the IPD input data
         */
        template<
            typename T_Worker,
            typename T_AreaMapping,
            typename T_LocalTimeRemainingBox,
            typename T_IonBox,
            typename T_LocalElectronHistogramDataBox,
            typename T_AtomicStateDataBox,
            typename T_TransitionDataBox,
            typename T_LocalCapturedWeightCacheBox,
            typename T_AtomicEnergyExchangeBox,
            typename... T_ChargeStateBoxAndIPDInput>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_AreaMapping const areaMapping,
            T_LocalTimeRemainingBox const timeRemainingBox,
            T_IonBox ionBox,
            T_LocalElectronHistogramDataBox electronHistogramDataBox,
            T_AtomicStateDataBox const atomicStateBox,
            T_TransitionDataBox const transitionBox,
            T_LocalCapturedWeightCacheBox capturedWeightCacheBox,
            T_AtomicEnergyExchangeBox atomicEnergyExchangeBox,
            T_ChargeStateBoxAndIPDInput... chargeStateBoxAndIPDInput) const
        {
            PMACC_CASSERT(
                CheckSetOfAtomicDataBoxes::transitionDataBoxMatchesProcessClass<
                    s_enums::ProcessClass::threeBodyRecombination,
                    T_TransitionDataBox>());

            VectorIdx const superCellIdx = KernelIndexation::getSuperCellIndex(worker, areaMapping);
            VectorIdx const superCellFieldIdx
                = KernelIndexation::getSuperCellFieldIndexFromSuperCellIndex(areaMapping, superCellIdx);

            auto const timeRemaining = timeRemainingBox(superCellFieldIdx);
            auto forEachLocalIonBoxEntry = pmacc::particles::algorithm::acc::makeForEach(worker, ionBox, superCellIdx);

            bool const superCellAlreadyFinished = (timeRemaining <= 0._X);
            bool const superCellHasIons = forEachLocalIonBoxEntry.hasParticles();
            if(superCellAlreadyFinished || !superCellHasIons)
                return;

            using Histogram = typename T_LocalElectronHistogramDataBox::ValueType;

            // get histogram and captured weight cache for current superCell
            Histogram& electronHistogram = electronHistogramDataBox(superCellFieldIdx);
            auto& capturedWeightCache = capturedWeightCacheBox(superCellFieldIdx);
            auto& atomicEnergyExchange = atomicEnergyExchangeBox(superCellFieldIdx);

            // eV
            PMACC_SMEM(worker, superCellConstantIPDInput, typename T_IPDModel::SuperCellConstantInput);

            //! weighted eV, block wide accumulator of the atomic energy ledger
            PMACC_SMEM(worker, sharedAtomicEnergy, float_64);

            auto onlyMaster = lockstep::makeMaster(worker);
            onlyMaster(
                [&superCellConstantIPDInput,
                 &sharedAtomicEnergy,
                 &superCellFieldIdx,
                 &chargeStateBoxAndIPDInput...]()
                {
                    sharedAtomicEnergy = 0.0;

                    superCellConstantIPDInput
                        = ionizationPotentialDepression::PassIPDInputs::template getSuperCellConstantInput<
                            T_IPDModel>(superCellFieldIdx, chargeStateBoxAndIPDInput...);
                });
            worker.sync();

            // weighted eV, private to this worker thread
            float_64 threadAtomicEnergy = 0.0;

            forEachLocalIonBoxEntry(
                [&electronHistogram,
                 &capturedWeightCache,
                 &threadAtomicEnergy,
                 &atomicStateBox,
                 &transitionBox,
                 &superCellConstantIPDInput,
                 &chargeStateBoxAndIPDInput...](T_Worker const& worker, auto& ion)
                {
                    if constexpr(picongpu::atomicPhysics::debug::kernel::recordChanges::CHECK_FOR_ACCEPTANCE)
                        if(!ion[accepted_])
                            printf("atomicPhysics ERROR: non accepted ion detected in recordChanges kernel\n");

                    uint8_t const processClass = ion[processClass_];

                    // not a threeBodyRecombination transition
                    if(processClass != u8(s_enums::ProcessClass::threeBodyRecombination))
                        return;

                    uint32_t const transitionIndex = ion[transitionIndex_];

                    // eV, same lower-state threshold convention as the upward ionization of this transition
                    float_X const ionizationPotentialDepression
                        = ionizationPotentialDepression::template getBoundFreeLowerStateIPD<T_IPDModel>(
                            atomicStateBox,
                            transitionBox,
                            transitionIndex,
                            superCellConstantIPDInput);

                    // eV, IPD-shifted energy released by the recombination
                    float_X const deltaEnergy = picongpu::particles::atomicPhysics::DeltaEnergyTransition::get(
                        transitionIndex,
                        atomicStateBox,
                        transitionBox,
                        ionizationPotentialDepression,
                        chargeStateBoxAndIPDInput...);

                    // downward process, new state is lower state of transition
                    uint32_t const newAtomicStateCollectionIndex
                        = transitionBox.lowerStateCollectionIndex(transitionIndex);

                    uint32_t const binIndex = ion[binIndex_];
                    float_X const weight = ion[weighting_];

                    /* reserve the free electron weight this recombination consumes BEFORE committing the ion to
                     *  its new atomic state.
                     *
                     * ApplyElectronCapture can only remove the weight the bin holds. Recombining the ion while the
                     *  bin cannot supply the matching free electron weight leaves that weight in the simulation and
                     *  creates charge, so a capture that does not fit is skipped entirely: the ion keeps its
                     *  current state and may recombine in a later sub-step.
                     *
                     * @attention must stay in front of SetAtomicState and of the atomic energy ledger, so that the
                     *  state change, the energy bookkeeping and the electron capture either all happen or none do */
                    if constexpr(!picongpu::atomicPhysics::debug::fixedRateMatrix::
                                     USE_FIXED_RATE_INSTEAD_OF_RATE_CALCULATION)
                        if(!capturedWeightCache
                                .tryReserve(worker, binIndex, weight, electronHistogram.getBinWeight0(binIndex)))
                            return;

                    // update atomic state
                    picongpu::particles::atomicPhysics::SetAtomicState::op(
                        atomicStateBox,
                        ion,
                        newAtomicStateCollectionIndex);

                    /* no energy accounting if using fixed matrix
                     *
                     * @attention the atomic energy ledger below must stay on this side of the early return, so
                     *  that it only ever records exchanges whose counterpart also happened */
                    if constexpr(picongpu::atomicPhysics::debug::fixedRateMatrix::
                                     USE_FIXED_RATE_INSTEAD_OF_RATE_CALCULATION)
                        return;

                    threadAtomicEnergy -= static_cast<float_64>(deltaEnergy) * static_cast<float_64>(weight);

                    /* released binding energy and the captured electron's kinetic energy are transferred to the
                     *  remaining free electrons, eV weighted */
                    electronHistogram.addDeltaEnergy(
                        worker,
                        binIndex,
                        (deltaEnergy + electronHistogram.getBinEnergy(binIndex)) * weight);

                    /* captured weight was already reserved in the cache above */
                });

            // reduce the ledger contributions of this block, one global atomic per block instead of per macro ion
            alpaka::atomicAdd(
                worker.getAcc(),
                &sharedAtomicEnergy,
                threadAtomicEnergy,
                ::alpaka::hierarchy::Threads{});
            worker.sync();

            onlyMaster(
                [&worker, &atomicEnergyExchange, &sharedAtomicEnergy]()
                {
                    atomicEnergyExchange.template addAtomicEnergyBlockWide<
                        s_enums::ProcessClass::threeBodyRecombination>(worker, sharedAtomicEnergy);
                });
        }
    };

    /** specialization for radiative-recombination
     *
     * Radiative-recombination captures a free electron and emits a photon carrying the captured electron's kinetic
     *  energy plus the released binding energy. The emitted photon is not tracked(optically thin approximation),
     *  therefore no energy is recorded to the electron histogram, the captured electron's energy leaves the
     *  simulation with its weight in the electron capture sub-stage.
     */
    template<typename T_IPDModel>
    struct RecordChangesKernel<s_enums::ProcessClass::radiativeRecombination, T_IPDModel>
    {
        using VectorIdx = pmacc::DataSpace<picongpu::simDim>;

        /** call operator
         *
         * called by RecordChanges atomicPhysics sub-stage
         *
         * @param worker object containing the device and block information, passed by PMACC_KERNEL call
         * @param areaMapping mapping of blockIndex to block superCell index
         * @param timeRemainingBox deviceDataBox giving access to the local time remaining of all local super
         * cells
         * @param ionBox deviceDataBox giving access to the particle frames of all local superCells
         * @param atomicStateBox deviceDataBox giving access to atomic state property data
         * @param transitionBox deviceDataBox giving access to bound-free transition property data, sorted by upper
         *  state
         * @param capturedWeightCacheBox deviceDataBox giving access to the captured weight cache of all local
         *  superCells
         */
        template<
            typename T_Worker,
            typename T_AreaMapping,
            typename T_LocalTimeRemainingBox,
            typename T_IonBox,
            typename T_LocalElectronHistogramDataBox,
            typename T_AtomicStateDataBox,
            typename T_TransitionDataBox,
            typename T_LocalCapturedWeightCacheBox,
            typename T_AtomicEnergyExchangeBox,
            typename... T_ChargeStateBoxAndIPDInput>
        HDINLINE void operator()(
            T_Worker const& worker,
            T_AreaMapping const areaMapping,
            T_LocalTimeRemainingBox const timeRemainingBox,
            T_IonBox ionBox,
            T_LocalElectronHistogramDataBox electronHistogramDataBox,
            T_AtomicStateDataBox const atomicStateBox,
            T_TransitionDataBox const transitionBox,
            T_LocalCapturedWeightCacheBox capturedWeightCacheBox,
            T_AtomicEnergyExchangeBox atomicEnergyExchangeBox,
            T_ChargeStateBoxAndIPDInput... chargeStateBoxAndIPDInput) const
        {
            PMACC_CASSERT(
                CheckSetOfAtomicDataBoxes::transitionDataBoxMatchesProcessClass<
                    s_enums::ProcessClass::radiativeRecombination,
                    T_TransitionDataBox>());

            VectorIdx const superCellIdx = KernelIndexation::getSuperCellIndex(worker, areaMapping);
            VectorIdx const superCellFieldIdx
                = KernelIndexation::getSuperCellFieldIndexFromSuperCellIndex(areaMapping, superCellIdx);

            auto const timeRemaining = timeRemainingBox(superCellFieldIdx);
            auto forEachLocalIonBoxEntry = pmacc::particles::algorithm::acc::makeForEach(worker, ionBox, superCellIdx);

            bool const superCellAlreadyFinished = (timeRemaining <= 0._X);
            bool const superCellHasIons = forEachLocalIonBoxEntry.hasParticles();
            if(superCellAlreadyFinished || !superCellHasIons)
                return;

            auto& electronHistogram = electronHistogramDataBox(superCellFieldIdx);
            auto& capturedWeightCache = capturedWeightCacheBox(superCellFieldIdx);
            auto& atomicEnergyExchange = atomicEnergyExchangeBox(superCellFieldIdx);

            PMACC_SMEM(worker, superCellConstantIPDInput, typename T_IPDModel::SuperCellConstantInput);

            //! weighted eV, block wide accumulators of the atomic energy ledger
            PMACC_SMEM(worker, sharedAtomicEnergy, float_64);
            PMACC_SMEM(worker, sharedRadiatedEnergy, float_64);

            auto onlyMaster = lockstep::makeMaster(worker);
            onlyMaster(
                [&superCellConstantIPDInput,
                 &sharedAtomicEnergy,
                 &sharedRadiatedEnergy,
                 &superCellFieldIdx,
                 &chargeStateBoxAndIPDInput...]()
                {
                    sharedAtomicEnergy = 0.0;
                    sharedRadiatedEnergy = 0.0;

                    superCellConstantIPDInput
                        = ionizationPotentialDepression::PassIPDInputs::template getSuperCellConstantInput<
                            T_IPDModel>(superCellFieldIdx, chargeStateBoxAndIPDInput...);
                });
            worker.sync();

            // weighted eV, private to this worker thread
            float_64 threadAtomicEnergy = 0.0;
            float_64 threadRadiatedEnergy = 0.0;

            forEachLocalIonBoxEntry(
                [&electronHistogram,
                 &capturedWeightCache,
                 &threadAtomicEnergy,
                 &threadRadiatedEnergy,
                 &atomicStateBox,
                 &transitionBox,
                 &superCellConstantIPDInput,
                 &chargeStateBoxAndIPDInput...](T_Worker const& worker, auto& ion)
                {
                    if constexpr(picongpu::atomicPhysics::debug::kernel::recordChanges::CHECK_FOR_ACCEPTANCE)
                        if(!ion[accepted_])
                            printf("atomicPhysics ERROR: non accepted ion detected in recordChanges kernel\n");

                    uint8_t const processClass = ion[processClass_];

                    // not a radiativeRecombination transition
                    if(processClass != u8(s_enums::ProcessClass::radiativeRecombination))
                        return;

                    uint32_t const transitionIndex = ion[transitionIndex_];

                    float_X const ionizationPotentialDepression
                        = ionizationPotentialDepression::template getBoundFreeLowerStateIPD<T_IPDModel>(
                            atomicStateBox,
                            transitionBox,
                            transitionIndex,
                            superCellConstantIPDInput);

                    float_X const transitionEnergy = DeltaEnergyTransition::get(
                        transitionIndex,
                        atomicStateBox,
                        transitionBox,
                        ionizationPotentialDepression,
                        chargeStateBoxAndIPDInput...);
                    float_64 const weight = static_cast<float_64>(ion[weighting_]);
                    uint32_t const binIndex = ion[binIndex_];

                    // downward process, new state is lower state of transition
                    uint32_t const newAtomicStateCollectionIndex
                        = transitionBox.lowerStateCollectionIndex(transitionIndex);

                    /* reserve the free electron weight this recombination consumes BEFORE committing the ion to
                     *  its new atomic state, see the equivalent reservation in the threeBodyRecombination kernel.
                     *
                     * Radiative recombination is outside the CollisionalBoundFreePairCap, which by construction
                     *  only covers collisional ionization and its detailed balance inverse, so nothing else bounds
                     *  how much electron weight it draws from a bin. */
                    if constexpr(!picongpu::atomicPhysics::debug::fixedRateMatrix::
                                     USE_FIXED_RATE_INSTEAD_OF_RATE_CALCULATION)
                        if(!capturedWeightCache.tryReserve(
                               worker,
                               binIndex,
                               ion[weighting_],
                               electronHistogram.getBinWeight0(binIndex)))
                            return;

                    // update atomic state
                    picongpu::particles::atomicPhysics::SetAtomicState::op(
                        atomicStateBox,
                        ion,
                        newAtomicStateCollectionIndex);

                    /* no energy accounting if using fixed matrix
                     *
                     * @attention the atomic energy ledger below must stay on this side of the early return, so
                     *  that it only ever records exchanges whose counterpart (the electron capture) also
                     *  happened */
                    if constexpr(picongpu::atomicPhysics::debug::fixedRateMatrix::
                                     USE_FIXED_RATE_INSTEAD_OF_RATE_CALCULATION)
                        return;

                    threadAtomicEnergy -= static_cast<float_64>(transitionEnergy) * weight;

                    /* the emitted photon carries the released binding energy plus the captured electron's kinetic
                     *  energy out of the simulation, eV weighted */
                    threadRadiatedEnergy
                        += (static_cast<float_64>(transitionEnergy)
                            + static_cast<float_64>(electronHistogram.getBinEnergy(binIndex)))
                        * weight;

                    /* captured weight was already reserved in the cache above */
                });

            // reduce the ledger contributions of this block, one global atomic per block instead of per macro ion
            alpaka::atomicAdd(
                worker.getAcc(),
                &sharedAtomicEnergy,
                threadAtomicEnergy,
                ::alpaka::hierarchy::Threads{});
            alpaka::atomicAdd(
                worker.getAcc(),
                &sharedRadiatedEnergy,
                threadRadiatedEnergy,
                ::alpaka::hierarchy::Threads{});
            worker.sync();

            onlyMaster(
                [&worker, &atomicEnergyExchange, &sharedAtomicEnergy, &sharedRadiatedEnergy]()
                {
                    atomicEnergyExchange.template addAtomicEnergyBlockWide<
                        s_enums::ProcessClass::radiativeRecombination>(worker, sharedAtomicEnergy);
                    atomicEnergyExchange.template addRadiatedEnergyBlockWide<
                        s_enums::ProcessClass::radiativeRecombination>(worker, sharedRadiatedEnergy);
                });
        }
    };

    // no change physical transition never changes anything
    template<typename T_IPDModel>
    struct RecordChangesKernel<s_enums::ProcessClass::noChange, T_IPDModel>;
} // namespace picongpu::particles::atomicPhysics::kernel
